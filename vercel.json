{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"INTLLM website: static files, output = public/\"",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/info", "destination": "/info.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/install", "destination": "/install.html" },
    { "source": "/author", "destination": "/author.html" }
  ],
  "headers": [
    {
      "source": "/install.(ps1|sh)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
